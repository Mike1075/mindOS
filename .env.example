# Vercel AI Gateway key
# Get from: https://vercel.com/dashboard/ai-gateway
# In Vercel project settings: Settings → Environment Variables → Add AI_GATEWAY_API_KEY
AI_GATEWAY_API_KEY=your_vck_key_here

# Azure 语音服务（TTS）— 语音交互朗读用
# 门户 → 语音服务资源 → 密钥和终结点
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=westus3
AZURE_SPEECH_VOICE=zh-CN-YunyeNeural
